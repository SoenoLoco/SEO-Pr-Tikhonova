{
  "ci": {
    "collect": {
      "url": [
        "http://localhost/",
        "http://localhost/halls/depo/",
        "http://localhost/afisha/kviz-60-sekund/",
        "http://localhost/contacts/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:seo": ["error", {"minScore": 1}],
        "categories:accessibility": ["warn", {"minScore": 0.9}],
        "resource-summary:image:size": ["error", {"maxNumericValue": 600000}]
      }
    },
    "upload": {"target": "filesystem", "outputDir": "lhci-report"}
  }
}
